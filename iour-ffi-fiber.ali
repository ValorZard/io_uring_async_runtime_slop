V "GNAT Lib v16"
A -gnatc
A -gnat2022
A -mtune=generic
A -march=x86-64
P DB LC TF ES NO

RN
RR PURE_BARRIERS
RR NO_ABORT_STATEMENTS
RR NO_ASYNCHRONOUS_CONTROL
RR NO_DYNAMIC_ATTACHMENT
RR NO_DYNAMIC_CPU_ASSIGNMENT
RR NO_DYNAMIC_PRIORITIES
RR NO_IMPLICIT_TASK_ALLOCATIONS
RR NO_IMPLICIT_PROTECTED_OBJECT_ALLOCATIONS
RR NO_LOCAL_TIMING_EVENTS
RR NO_LOCAL_PROTECTED_OBJECTS
RR NO_PROTECTED_TYPE_ALLOCATORS
RR NO_REQUEUE_STATEMENTS
RR NO_SELECT_STATEMENTS
RR NO_SPECIFIC_TERMINATION_HANDLERS
RR NO_TASK_ALLOCATORS
RR NO_TASK_ATTRIBUTES_PACKAGE
RR NO_TASK_HIERARCHY
RR NO_TASK_TERMINATION
RR NO_TERMINATE_ALTERNATIVES
RV NO_IMPLEMENTATION_ASPECT_SPECIFICATIONS
RV NO_ELABORATION_CODE
RR MAX_SELECT_ALTERNATIVES=0
RR MAX_TASK_ENTRIES=0
RR MAX_ASYNCHRONOUS_SELECT_NESTING=0

U iour.ffi.fiber%s	iour-ffi-fiber.ads	33d37c4d EE OO PK
W iour.ffi%s		iour-ffi.ads		iour-ffi.ali
W system%s		system.ads		system.ali

D interfac.ads		20260430083320 9111f9c1 interfaces%s
D i-c.ads		20260430083320 dbdd3be7 interfaces.c%s
D iour.ads		20260904013609 2e2a61b2 iour%s
D iour-ffi.ads		20260904005333 675c5442 iour.ffi%s
D iour-ffi-fiber.ads	20260904015301 b638e192 iour.ffi.fiber%s
D system.ads		20260430083320 e2b7c99d system%s
D s-parame.ads		20260430083320 a1aeab5c system.parameters%s
D gnat.adc		20260904005252 00000000
G a e
G c Z s s [reserve iour__ffi__fiber 30 13 none]
G c Z s s [slot_count iour__ffi__fiber 34 13 none]
G c Z s s [switch iour__ffi__fiber 41 14 none]
G c Z s s [stack_alloc iour__ffi__fiber 46 13 none]
G c Z s s [stack_free iour__ffi__fiber 50 14 none]
G c Z s s [prime iour__ffi__fiber 58 14 none]
G c Z s s [guard_size iour__ffi__fiber 66 13 none]
X 2 i-c.ads
62I9*int<integer>
64I9*long<long_integer>
92M9*size_t
X 3 iour.ads
35K9*Iour 172e9 5|22r9 70r5
X 4 iour-ffi.ads
23K14*Ffi 3|35k9 4|33e13 5|22r14 70r10
25I12*C_Int{2|62I9} 5|30r45
26I12*C_Long{2|64I9} 5|30r30 34r31 41r29 41r42 59r14 62r14
28M12*C_Size{2|92M9} 5|46r33 50r56 61r14 66r31
X 5 iour-ffi-fiber.ads
22K18*Fiber 4|23k14 5|70l14 70e19
30V13*Reserve{4|25I12} 30>22
30i22 Slots{4|26I12}
34V13*Slot_Count{4|26I12}
41U14*Switch 41>22 41>37
41i22 From{4|26I12}
41i37 To{4|26I12}
46V13*Stack_Alloc{6|67M9} 46>26
46m26 Size{4|28M12}
50U14*Stack_Free 50>26 50>49
50m26 Base{6|67M9}
50m49 Size{4|28M12}
58U14*Prime 59>7 60>7 61>7 62>7
59i7 Slot{4|26I12}
60m7 Base{6|67M9}
61m7 Size{4|28M12}
62i7 Arg{4|26I12}
66V13*Guard_Size{4|28M12}
X 6 system.ads
37K9*System 5|20w6 46r48 50r33 60r14 6|155e11
67M9*Address 5|46r55 50r40 60r21

