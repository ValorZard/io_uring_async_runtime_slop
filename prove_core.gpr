--  The whole runtime, less the example mains.  The two SPARK_Mode => Off
--  bodies (Iour.Ffi.Fiber, Iour.Ffi.Memory) are included so gnatprove sees
--  and reports them as such; their specs are verified like any other.
project Prove_Core is
   for Languages use ("Ada");
   for Source_Dirs use
     ("src", "src/ffi", "src/runtime", "src/net", "src/arch/x86_64",
      "examples");
   for Source_Files use
     ("iour.ads",
      "iour-ffi.ads",
      "iour-ffi-fiber.ads",     "iour-ffi-fiber.adb",
      "iour-ffi-sys.ads",       "iour-ffi-sys.adb",
      "iour-ffi-net.ads",       "iour-ffi-net.adb",
      "iour-ffi-uring.ads",
      "iour-ffi-memory.ads",    "iour-ffi-memory.adb",
      "iour-futures.ads",       "iour-futures.adb",
      "iour-run_queue.ads",     "iour-run_queue.adb",
      "iour-fibers.ads",        "iour-fibers.adb",
      "iour-scheduler.ads",     "iour-scheduler.adb",
      "iour-shards.ads",        "iour-shards.adb",
      "iour-async.ads",         "iour-async.adb",
      "iour-promises.ads",      "iour-promises.adb",
      "iour-trace.ads",         "iour-trace.adb",
      "iour-text.ads",          "iour-text.adb",
      "iour-reactor.ads",       "iour-reactor.adb",
      "iour-net.ads",           "iour-net.adb",
      "iour-time.ads",          "iour-time.adb",
      "echo_protocol.ads",      "echo_protocol.adb");
   for Object_Dir use "obj/prove_core";
   for Create_Missing_Dirs use "True";
   package Builder is
      for Global_Configuration_Pragmas use "gnat.adc";
   end Builder;
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;
end Prove_Core;
