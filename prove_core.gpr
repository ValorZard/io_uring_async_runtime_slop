--  The subset of the runtime that never has to hand an object's address to
--  the kernel, and so falls entirely inside SPARK's analysable subset.
project Prove_Core is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "src/runtime", "examples");
   for Source_Files use
     ("iour.ads",
      "iour-futures.ads", "iour-futures.adb",
      "iour-run_queue.ads", "iour-run_queue.adb",
      "echo_protocol.ads", "echo_protocol.adb");
   for Object_Dir use "obj/prove_core";
   for Create_Missing_Dirs use "True";
   package Builder is
      for Global_Configuration_Pragmas use "gnat.adc";
   end Builder;
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;
end Prove_Core;
