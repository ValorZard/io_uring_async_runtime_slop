with "io_uring_async_runtime.gpr";
project Tests is
   for Source_Dirs use ("tests");
   for Object_Dir use "obj/tests";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("smoke.adb", "multi_await.adb");
   package Builder is
      for Global_Configuration_Pragmas use "gnat.adc";
   end Builder;
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-g", "-gnatwa", "-gnatw.X", "-gnatf");
   end Compiler;
   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end Tests;
