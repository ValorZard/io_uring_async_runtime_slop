--  The runtime library.  Ada throughout; the context switch is GNAT inline
--  Asm in src/arch/<target>, and that body is the only SPARK_Mode => Off
--  unit outside the platform backends.
--
--  Two things vary with the host, and only these two: which of the two
--  bodies under src/os implements Iour.Reactor, Iour.Ffi.Sys and
--  Iour.Ffi.Net, and which calling convention the context switch is
--  written against.  Everything under src, src/ffi, src/runtime and
--  src/net compiles unchanged on both.
library project Io_Uring_Async_Runtime is

   for Languages use ("Ada");

   --  Which host, decided by the OS environment variable Windows sets for
   --  every process and no Unix does.  Override it with IOUR_OS when
   --  cross-compiling, or when a shell has borrowed the name:
   --
   --     gprbuild -P io_uring_async_runtime.gpr -XIOUR_OS=linux
   type Os_Kind is ("linux", "Windows_NT");
   Host_Os : Os_Kind := external ("IOUR_OS", external ("OS", "linux"));

   --  Which instruction set, and so which context switch.  There is no
   --  environment variable a build is entitled to read for this the way OS
   --  serves above -- nothing portable exports the machine type -- so it
   --  defaults to x86_64 and an AArch64 build asks for itself:
   --
   --     gprbuild -P io_uring_async_runtime.gpr -XIOUR_ARCH=aarch64
   --
   --  Getting it wrong does not build something subtly wrong: the assembler
   --  rejects the other target's instructions.
   type Arch_Kind is ("x86_64", "aarch64");
   Host_Arch : Arch_Kind := external ("IOUR_ARCH", "x86_64");

   --  How many shards, chosen by the build rather than by editing a
   --  source file.  A GPR external is a string available only to the
   --  project, and Shard_Count has to reach Ada as a *static* constant --
   --  Jorvik requires each shard task's CPU aspect to be static, and
   --  Active_Shard is a subtype bounded by it.  So the value cannot be
   --  passed through; a directory holding one declaration of Iour_Config
   --  is selected instead, and each of them declares a different value.
   --
   --     gprbuild -P io_uring_async_runtime.gpr -XIOUR_SHARDS=2
   --
   --  The runtime needs First_Shard_Cpu + Shard_Count - 1 CPUs to exist,
   --  which with First_Shard_Cpu at 1 is exactly this many.
   type Shards_Kind is ("1", "2", "3", "4", "5", "6", "7", "8");
   Shards : Shards_Kind := external ("IOUR_SHARDS", "4");
   Config_Dir := "src/config/shards-" & Shards;

   Portable_Dirs := ("src", "src/ffi", "src/runtime", "src/net")
                    & Config_Dir;

   case Host_Os is
      when "Windows_NT" =>
         --  Only x86-64 here.  An AArch64 Windows build would need a
         --  Win64-on-ARM context switch, which is a fourth ABI and not
         --  merely a fourth file, and there is no toolchain for it here.
         for Source_Dirs use
           Portable_Dirs & ("src/os/windows", "src/arch/x86_64-win64");
      when "linux" =>
         case Host_Arch is
            when "x86_64" =>
               for Source_Dirs use
                 Portable_Dirs & ("src/os/linux", "src/arch/x86_64-sysv");
            when "aarch64" =>
               for Source_Dirs use
                 Portable_Dirs
                 & ("src/os/linux", "src/arch/aarch64-aapcs64");
         end case;
   end case;

   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Library_Name use "iour";
   for Library_Kind use "static";
   for Create_Missing_Dirs use "True";

   package Builder is
      for Global_Configuration_Pragmas use "gnat.adc";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022",       --  Ada 2022
         "-O2",
         "-g",
         "-gnatwa",         --  all warnings
         "-gnatw.X",        --  quiet about No_Exception_Propagation
         "-gnatf",          --  full error detail
         --  One frame this large is worth a human look.  Fiber stacks are
         --  Fiber_Stack_Bytes -- 64 KiB, one guard page below -- and in a
         --  runtime with no heap every buffer is a static local, so an
         --  oversized local array is the realistic way to overrun one.
         --  Whole-call-graph analysis would be better and is not available
         --  here: it needs GNATstack over -fcallgraph-info, which the
         --  Alire FSF toolchain does not ship.  A per-frame bound is what
         --  is left, and it catches the case that actually happens.
         --
         --  Not -Wstack-usage, which bounds the same thing and also warns
         --  when a frame is dynamically sized.  That sounds better and is
         --  unusable here: `"n =" & X'Image` builds a temporary whose
         --  size is computed, so every subprogram that formats a message
         --  reports "stack usage might be unbounded" -- six of them
         --  across the examples and tests, none of them a defect.  The
         --  cost of the narrower flag is that a runaway dynamic frame on
         --  a fiber stack is not caught; the guard page is what catches
         --  that one.
         --
         --  16 KiB is a quarter of a fiber stack and fires on nothing
         --  today.  The largest frame measured on Windows is
         --  Scheduler.Run at 8432 bytes, then Reactor.Drain at 4240 and
         --  Harvest at 4176 -- all three on a shard's thread stack, not
         --  on a fiber's.  Everything reached from a fiber is in the
         --  hundreds of bytes.  Add -fstack-usage for the per-subprogram
         --  .su files those numbers came from.
         "-Wframe-larger-than=16384");
   end Compiler;

   package Linker is
      case Host_Os is
         when "Windows_NT" =>
            --  Winsock for the sockets.  The IoRing entry points are
            --  resolved with GetProcAddress instead of linked, so that the
            --  binary still starts on a Windows without them -- see
            --  Iour.Ffi.Win32.
            for Linker_Options use ("-lws2_32");
         when "linux" =>
            --  liburing supplies io_uring_setup, io_uring_enter and
            --  io_uring_register; everything else in the ring protocol is
            --  Ada.
            for Linker_Options use ("-luring");
      end case;
   end Linker;

end Io_Uring_Async_Runtime;
