--  The runtime library.  Ada throughout; the context switch is GNAT inline
--  Asm in src/arch/<target>, and that body is the only SPARK_Mode => Off
--  unit in the project.
library project Io_Uring_Async_Runtime is

   for Languages use ("Ada");
   for Source_Dirs use
     ("src", "src/ffi", "src/runtime", "src/net", "src/arch/x86_64");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Library_Name use "iour";
   for Library_Kind use "static";
   for Create_Missing_Dirs use "True";

   package Builder is
      for Global_Configuration_Pragmas use "gnat.adc";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022",       --  Ada 2022
         "-O2",
         "-g",
         "-gnatwa",         --  all warnings
         "-gnatw.X",        --  quiet about No_Exception_Propagation
         "-gnatf");         --  full error detail
   end Compiler;

   package Linker is
      --  liburing supplies io_uring_setup and io_uring_enter; everything
      --  else in the ring protocol is Ada.
      for Linker_Options use ("-luring");
   end Linker;

end Io_Uring_Async_Runtime;
