--  The runtime library: SPARK Ada, plus the one C file that holds the
--  context-switch assembly.
library project Io_Uring_Async_Runtime is

   for Languages use ("Ada", "C");
   for Source_Dirs use ("src", "src/ffi", "src/runtime", "src/net", "src/c");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Library_Name use "iour";
   for Library_Kind use "static";
   for Create_Missing_Dirs use "True";

   package Builder is
      for Global_Configuration_Pragmas use "gnat.adc";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022",       --  Ada 2022
         "-O2",
         "-g",
         "-gnatwa",         --  all warnings
         "-gnatw.X",        --  quiet about No_Exception_Propagation
         "-gnatf");         --  full error detail
      for Default_Switches ("C") use
        ("-O2", "-g", "-Wall", "-Wextra", "-fno-omit-frame-pointer");
   end Compiler;

   package Linker is
      --  liburing supplies io_uring_setup and io_uring_enter; everything
      --  else in the ring protocol is Ada.
      for Linker_Options use ("-luring");
   end Linker;

end Io_Uring_Async_Runtime;
