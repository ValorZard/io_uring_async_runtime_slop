--  SPARK analysis project, over the whole runtime.
project Prove is
   for Languages use ("Ada");
   for Source_Dirs use
     ("src", "src/ffi", "src/runtime", "src/net", "src/arch/x86_64");
   for Object_Dir use "obj/prove";
   for Create_Missing_Dirs use "True";

   package Builder is
      for Global_Configuration_Pragmas use "gnat.adc";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;
end Prove;
