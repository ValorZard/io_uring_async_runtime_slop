--  SPARK analysis project.  Ada sources only: gnatprove does not analyse C,
--  and the single C file in this project is the context-switch assembly.
project Prove is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "src/ffi", "src/runtime", "src/net");
   for Object_Dir use "obj/prove";
   for Create_Missing_Dirs use "True";

   package Builder is
      for Global_Configuration_Pragmas use "gnat.adc";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;
end Prove;
